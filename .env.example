# ============================================================
# CaseVault — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ---- Database ----
DATABASE_URL=postgresql://casevault:casevault@localhost:5432/casevault
POSTGRES_USER=casevault
POSTGRES_PASSWORD=casevault
POSTGRES_DB=casevault

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---- Backend Security ----
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ---- Document Storage (Day 4) ----
# Absolute path to the directory where uploaded documents are stored.
# Must be outside the application source tree. Excluded from Git via .gitignore.
# Default: <backend_root>/storage/documents
DOCUMENT_STORAGE_PATH=/var/casevault/storage/documents

# Maximum allowed upload size in bytes. Default: 10485760 (10 MB)
MAX_UPLOAD_SIZE_BYTES=10485760

# Chunk size in words per chunk. Words * 1.3 ≈ tokens (estimated). Default: 500
CHUNK_SIZE_WORDS=500

# Word overlap between adjacent chunks. Default: 60
CHUNK_OVERLAP_WORDS=60

# ---- Embeddings (Day 5) ----
# Local sentence-transformers model. Model is downloaded on first use (~90 MB).
# To change the model, also update EMBEDDING_DIM to match the new dimension.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Vector dimension for the embedding model. Must match vector(N) in the DB.
EMBEDDING_DIM=384

# Number of chunks embedded per batch during bulk processing.
EMBEDDING_BATCH_SIZE=64

# ---- Search (Day 5) ----
# Default number of results returned by POST /search.
SEARCH_DEFAULT_LIMIT=10

# Maximum allowed limit per search request.
SEARCH_MAX_LIMIT=50

# ---- AI / LLM (Day 6+) ----
LLM_API_KEY=

# ---- Application ----
DEBUG=false
