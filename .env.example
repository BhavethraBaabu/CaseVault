# ============================================================
# CaseVault — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ---- Database ----
DATABASE_URL=postgresql://casevault:casevault@localhost:5432/casevault
POSTGRES_USER=casevault
POSTGRES_PASSWORD=casevault
POSTGRES_DB=casevault

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---- Backend Security ----
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ---- AI / LLM (Day 5+) ----
LLM_API_KEY=
EMBEDDING_API_KEY=

# ---- Application ----
DEBUG=false
